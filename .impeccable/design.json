  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action that matters on a surface (Ask, Apply, Add).",
      "html": "<button class=\"ds-btn-primary\">Ask pokérag</button>",
      "css": ".ds-btn-primary{font-family:var(--font-sans),'Space Grotesk',ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:500;background:#d8310c;color:#fff;border:0;border-radius:10px;padding:8px 14px;cursor:pointer;transition:filter .18s,box-shadow .18s}.ds-btn-primary:hover{filter:brightness(1.06);box-shadow:0 10px 30px -10px #d8310c}.ds-btn-primary:focus-visible{outline:2px solid #d8310c;outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary actions beside a primary.",
      "html": "<button class=\"ds-btn-ghost\">Compare team</button>",
      "css": ".ds-btn-ghost{font-family:var(--font-sans),'Space Grotesk',ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:500;background:#f4f5f8;color:#14171d;border:1px solid rgba(20,23,29,.1);border-radius:10px;padding:8px 14px;cursor:pointer;transition:color .18s,border-color .18s}.ds-btn-ghost:hover{border-color:#d8310c;color:#d8310c}.ds-btn-ghost:focus-visible{outline:2px solid #d8310c;outline-offset:2px}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Species search with leading icon; red border and halo on focus.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg><input placeholder=\"Search any of 1,025 species…\"></label>",
      "css": ".ds-search{position:relative;display:block;max-width:460px}.ds-search svg{position:absolute;left:13px;top:15px;width:18px;height:18px;color:#5f6773}.ds-search input{width:100%;height:48px;border:1.5px solid rgba(20,23,29,.1);border-radius:10px;background:#fff;padding:0 16px 0 42px;font-family:var(--font-sans),'Space Grotesk',ui-sans-serif,system-ui,sans-serif;font-size:15px;color:#14171d;outline:none;transition:border-color .15s,box-shadow .15s}.ds-search input::placeholder{color:#5f6773}.ds-search input:focus{border-color:#d8310c;box-shadow:0 0 0 3px rgba(227,53,13,.12)}"
    },
    {
      "name": "Nav Tray",
      "kind": "nav",
      "refersTo": "nav-tray-link",
      "description": "Sentence-case links in a faint tray, current page raised, red Ask CTA.",
      "html": "<nav class=\"ds-nav\"><div class=\"ds-tray\"><a class=\"on\" href=\"#\">Home</a><a href=\"#\">Pokédex</a><a href=\"#\">Teams</a></div><a class=\"ds-cta\" href=\"#\">Ask</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:10px;font-family:var(--font-sans),'Space Grotesk',ui-sans-serif,system-ui,sans-serif;}.ds-tray{display:flex;padding:3px;border-radius:10px;background:rgba(20,23,29,.05)}.ds-tray a{font-size:14px;font-weight:500;color:#5f6773;padding:6px 12px;border-radius:8px;text-decoration:none;transition:color .18s,background .18s}.ds-tray a:hover{color:#14171d}.ds-tray a.on{color:#14171d;background:#fff;box-shadow:0 1px 2px rgba(20,23,29,.12)}.ds-cta{font-size:14px;font-weight:500;padding:8px 14px;border-radius:10px;background:#d8310c;color:#fff;text-decoration:none}.ds-cta:hover{filter:brightness(1.06)}.ds-nav a:focus-visible{outline:2px solid #d8310c;outline-offset:2px}"
    },
    {
      "name": "Type Tag",
      "kind": "chip",
      "refersTo": "type-tag",
      "description": "Static type identity: type fill, label in the type's deep 'on' shade.",
      "html": "<span class=\"ds-tt\" style=\"--c:#f0803c;--on:#582400\">fire</span> <span class=\"ds-tt\" style=\"--c:#5aa0e6;--on:#02315a\">water</span> <span class=\"ds-tt\" style=\"--c:#f4cf46;--on:#564602\">electric</span> <span class=\"ds-tt\" style=\"--c:#7a5cf0;--on:#fff\">dragon</span>",
      "css": ".ds-tt{display:inline-block;font-family:var(--font-sans),'Space Grotesk',ui-sans-serif,system-ui,sans-serif;font-weight:700;text-transform:capitalize;color:var(--on,#fff);background:var(--c);padding:4px 9px;border-radius:6px;font-size:11px;letter-spacing:.01em}"
    },
    {
      "name": "Type Filter Chips",
      "kind": "chip",
      "refersTo": "type-chip",
      "description": "Ghost to fill: muted at rest, type colour with soft glow when on.",
      "html": "<div class=\"ds-tg\"><button style=\"--c:#6fc25a;--on:#154a02\" class=\"on\">grass</button><button style=\"--c:#b25ec4;--on:#24002c\">poison</button><button style=\"--c:#f4cf46;--on:#564602\">electric</button></div>",
      "css": ".ds-tg{display:flex;gap:5px;flex-wrap:wrap}.ds-tg button{font-family:var(--font-sans),'Space Grotesk',ui-sans-serif,system-ui,sans-serif;font-size:11px;font-weight:700;text-transform:capitalize;color:#666e7b;background:transparent;padding:7px 12px;border-radius:10px;border:0;cursor:pointer;transition:all .14s}.ds-tg button:hover{color:#3a4049;background:#eceff3}.ds-tg button.on{color:var(--on,#fff);background:var(--c);box-shadow:0 3px 10px color-mix(in srgb,var(--c) 40%,transparent)}.ds-tg button:focus-visible{outline:2px solid #d8310c;outline-offset:2px}"
    },
    {
      "name": "Tool Card",
      "kind": "card",
      "refersTo": "card",
      "description": "A bento tile: white panel, hairline, 14px radius, no resting shadow, red go-link.",
