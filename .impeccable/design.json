      {
        "name": "The No Eyebrow Rule",
        "body": "Spaced-caps mono kickers (the old red-dot eyebrow) appear at most once per page region, and preferably never. Give a panel a real sentence-case heading instead.",
        "section": "typography"
      },
      {
        "name": "The Legible Floor Rule",
        "body": "Readable text is never below 12px. The 9 to 11px mono labels that exist today are debt, not precedent.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Depth at rest comes from hairlines and tone, never shadows. If a card needs a shadow to separate from the page, the ground is wrong, not the card.",
        "section": "elevation"
      }
    ],
    "dos": [
