# ---------------------------------------------------------------------------
# Pokédex RAG — environment configuration
# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- PostgreSQL (used by the `db` service and the backend) ---
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_DB=pokedex
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host port the Compose DB is published on (container port stays 5432).
# Change if 5433 is already in use on your machine.
POSTGRES_HOST_PORT=5433

# Async SQLAlchemy URL. Inside Compose the host is the `db` service name.
# For running the backend locally against the Compose DB, use localhost:5432.
DATABASE_URL=postgresql+asyncpg://pokedex:pokedex@db:5432/pokedex

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Host port the backend is published on (container port stays 8000).
BACKEND_HOST_PORT=8000

# Host port the frontend is published on (container port stays 3000).
FRONTEND_HOST_PORT=3000
# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000

# --- RAG assistant (LLM) ---
# "Ask the Pokédex" needs ONE of the providers below. Anthropic is preferred;
# if only a Groq key is set, the app uses Groq (free tier, OpenAI-compatible).
# Without either, retrieval still works but the answer endpoint returns 503.

# Option A — Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Option B — Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Frontend (Next.js) ---
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
