 },
 "openapi": "3.1.0",
 "paths": {
  "/api/generations": {
   "get": {
    "operationId": "list_generations_api_generations_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/GenerationOut"
         },
         "title": "Response List Generations Api Generations Get",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "List Generations",
    "tags": [
     "pokedex"
    ]
   }
  },
  "/api/pokemon": {
   "get": {
    "operationId": "list_pokemon_api_pokemon_get",
    "parameters": [
     {
      "description": "Search by name or dex number",
      "in": "query",
      "name": "q",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Search by name or dex number",
       "title": "Q"
      }
     },
     {
      "description": "Filter by type id(s); all must match",
      "in": "query",
      "name": "type",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "description": "Filter by type id(s); all must match",
       "title": "Type"
      }
     },
     {
      "description": "Filter by generation(s) 1-9; any may match",
      "in": "query",
      "name": "generation",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "items": {
          "type": "integer"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "description": "Filter by generation(s) 1-9; any may match",
       "title": "Generation"
      }
     },
     {
      "in": "query",
      "name": "legendary",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "title": "Legendary"
      }
     },
     {
      "in": "query",
      "name": "mythical",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "title": "Mythical"
      }
     },
     {
      "in": "query",
      "name": "sort",
      "required": false,
      "schema": {
       "default": "dex",
       "title": "Sort",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
       "default": "asc",
       "pattern": "^(asc|desc)$",
       "title": "Order",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 40,
       "maximum": 200,
       "minimum": 1,
       "title": "Limit",
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "offset",
      "required": false,
      "schema": {
       "default": 0,
       "minimum": 0,
       "title": "Offset",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PokemonListResponse"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "List Pokemon",
    "tags": [
     "pokedex"
    ]
   }
  },
