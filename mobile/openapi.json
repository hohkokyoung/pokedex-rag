      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PokemonDetail"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Get Pokemon",
    "tags": [
     "pokedex"
    ]
   }
  },
  "/api/pokemon/{pokemon_id}/encounters": {
   "get": {
    "description": "Where a species or form (id > 10000) is found in the wild, one game at a time.",
    "operationId": "pokemon_encounters_api_pokemon__pokemon_id__encounters_get",
    "parameters": [
     {
      "in": "path",
      "name": "pokemon_id",
      "required": true,
      "schema": {
       "title": "Pokemon Id",
       "type": "integer"
      }
     },
     {
      "description": "Game (version) id; omit for the newest",
      "in": "query",
      "name": "version",
