event: sources
data: [{"n": 1, "pokemon_id": 39, "pokemon_name": "Jigglypuff", "dex_number": 39, "chunk_type": "profile", "source_ref": "target", "snippet": "Jigglypuff (National Pok\u00e9dex #39) is a Normal/Fairy-type Pok\u00e9mon, the Balloon Pok\u00e9mon. Base stats \u2014 HP 115, Attack 45, Defense 20, Special Attack 45, Special Defense 25, Speed 20 (base stat total 270). Abilities: Cute Charm, Competitive, Friend Guard. It is 0.5 m tall and weighs 5.5 kg. Its habitat is grassland.. Evolves from Igglybuff via level up; Evolves into Wigglytuff using Moon Stone", "score": 1.0, "step": "s1", "step_index": 0}, {"n": 2, "pokemon_id": 684, "pokemon_name": "Swirlix", "dex_number": 684, "chunk_type": "profile", "source_ref": "similar", "snippet": "Swirlix (National Pok\u00e9dex #684) is a Fairy-type Pok\u00e9mon, the Cotton Candy Pok\u00e9mon. Base stats \u2014 HP 62, Attack 48, Defense 66, Special Attack 59, Special Defense 57, Speed 49 (base stat total 341). Abilities: Sweet Veil, Unburden. It is 0.4 m tall and weighs 3.5 kg.. Evolves into Slurpuff by trading", "score": 0.8138, "step": "s1", "step_index": 1}, {"n": 3, "pokemon_id": 428, "pokemon_name": "Lopunny", "dex_number": 428, "chunk_type": "profile", "source_ref": "similar", "snippet": "Lopunny (National Pok\u00e9dex #428) is a Normal-type Pok\u00e9mon, the Rabbit Pok\u00e9mon. Base stats \u2014 HP 65, Attack 76, Defense 84, Special Attack 54, Special Defense 96, Speed 105 (base stat total 480). Abilities: Cute Charm, Klutz, Limber. It is 1.2 m tall and weighs 33.3 kg.. Evolves from Buneary via level up", "score": 0.7993, "step": "s1", "step_index": 2}, {"n": 4, "pokemon_id": 685, "pokemon_name": "Slurpuff", "dex_number": 685, "chunk_type": "profile", "source_ref": "similar", "snippet": "Slurpuff (National Pok\u00e9dex #685) is a Fairy-type Pok\u00e9mon, the Meringue Pok\u00e9mon. Base stats \u2014 HP 82, Attack 80, Defense 86, Special Attack 85, Special Defense 75, Speed 72 (base stat total 480). Abilities: Sweet Veil, Unburden. It is 0.8 m tall and weighs 5.0 kg.. Evolves from Swirlix by trading", "score": 0.7946, "step": "s1", "step_index": 3}, {"n": 5, "pokemon_id": 189, "pokemon_name": "Jumpluff", "dex_number": 189, "chunk_type": "profile", "source_ref": "similar", "snippet": "Jumpluff (National Pok\u00e9dex #189) is a Grass/Flying-type Pok\u00e9mon, the Cottonweed Pok\u00e9mon. Base stats \u2014 HP 75, Attack 55, Defense 70, Special Attack 55, Special Defense 95, Speed 110 (base stat total 460). Abilities: Chlorophyll, Leaf Guard, Infiltrator. It is 0.8 m tall and weighs 3.0 kg. Its habitat is grassland.. Evolves from Skiploom at level 27", "score": 0.7905, "step": "s1", "step_index": 4}, {"n": 6, "pokemon_id": 187, "pokemon_name": "Hoppip", "dex_number": 187, "chunk_type": "profile", "source_ref": "similar", "snippet": "Hoppip (National Pok\u00e9dex #187) is a Grass/Flying-type Pok\u00e9mon, the Cottonweed Pok\u00e9mon. Base stats \u2014 HP 35, Attack 35, Defense 40, Special Attack 35, Special Defense 55, Speed 50 (base stat total 250). Abilities: Chlorophyll, Leaf Guard, Infiltrator. It is 0.4 m tall and weighs 0.5 kg. Its habitat is grassland.. Evolves into Skiploom at level 18", "score": 0.7863, "step": "s1", "step_index": 5}, {"n": 7, "pokemon_id": 427, "pokemon_name": "Buneary", "dex_number": 427, "chunk_type": "profile", "source_ref": "similar", "snippet": "Buneary (National Pok\u00e9dex #427) is a Normal-type Pok\u00e9mon, the Rabbit Pok\u00e9mon. Base stats \u2014 HP 55, Attack 66, Defense 44, Special Attack 44, Special Defense 56, Speed 85 (base stat total 350). Abilities: Run Away, Klutz, Limber. It is 0.4 m tall and weighs 5.5 kg.. Evolves into Lopunny via level up", "score": 0.7851, "step": "s1", "step_index": 6}]

